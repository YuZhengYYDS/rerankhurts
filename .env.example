# Copy to `.env` and fill in. `.env` is read by legacy/run_rag_eval.py (answer
# generation and the LLM re-ranker) and by llm_judge.py (the automatic judge).
#
# The reference results in this repository were produced with DeepSeek's
# OpenAI-compatible endpoint and `deepseek-chat`. Any OpenAI-compatible endpoint
# works: set DEEPSEEK_BASE_URL to its /v1 URL and DEEPSEEK_MODEL to the model
# name it serves. The variable names are historical -- they describe the
# endpoint used for the paper, not a requirement to use DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
